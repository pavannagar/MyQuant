COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=

# Monitor/trade alerts go out via a Telegram bot (no 24h session-window restriction, unlike
# WhatsApp). Create one via @BotFather on Telegram, then message it once to get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: mirrors saved scanners/trash to this GitHub repo so they survive a Render restart.
# Leave blank to use local-file-only storage (fine for local dev / hosts with a real disk).
GITHUB_TOKEN=
GITHUB_REPO=pavannagar/MyQuant
GITHUB_BRANCH=main

# Keep off until you've verified the deployed instance behaves as expected.
LIVE_TRADING=0
TRADE_LEVERAGE=5
TRADE_RISK_INR=100
TRADE_TARGET_RR=1
TRADE_MAX_PER_DAY=5
TRADE_MAX_LOSS_INR_PER_DAY=500
